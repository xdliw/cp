{
  "tasks": [
    {
      "type": "cppbuild",
      "label": "g++20 CP LOCAL with -g",
      "command": "/usr/bin/g++",
      "args": [
        "-Wall",
        "-Wextra",
        "-Wconversion",
        "-static",
        "-O2",
        "-std=c++20",
        "-o",
        "${fileBasenameNoExtension}.out",
        "-DLOCAL",
        "-I${workspaceFolder}",
        "-g",
        "${file}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build",
      "detail": "Task with defined LOCAL macro. Dependent on the code/cp directory. Also with -g"
    },
    {
      "type": "cppbuild",
      "label": "C/C++20: g++ build active file",
      "command": "/usr/bin/g++",
      "args": [
        "-std=c++20",
        "-fdiagnostics-color=always",
        "-g",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build",
      "detail": "compiler: /usr/bin/g++"
    }
  ],
  "version": "2.0.0"
}