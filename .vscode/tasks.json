{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cppbuild",
      "label": "CF DEBUG",
      "command": "/usr/bin/g++",
      "args": [
        "-std=c++23", "-O0", "-g",
        "-Wall", "-Wextra", "-Wconversion", "-Wshadow",
        "-fsanitize=address,undefined",
        "-D_GLIBCXX_DEBUG",
        "-DDEBUG",
        "-fdiagnostics-color=always",
        "-I${workspaceFolder}",
        "${file}",
        "-o", "${fileDirname}/${fileBasenameNoExtension}_debug"
      ],
      "options": { "cwd": "${fileDirname}" },
      "problemMatcher": ["$gcc"],
      "group": "build",
      "detail": "Codeforces-style standard + warnings + sanitizers + DEBUG"
    },
    {
      "type": "cppbuild",
      "label": "CF RELEASE",
      "command": "/usr/bin/g++",
      "args": [
        "-Wall", "-Wextra", "-Wconversion",
        "-static",
        "-DONLINE_JUDGE",
        "-O2", "-std=c++23",
        "-fdiagnostics-color=always",
        "${file}",
        "-o", "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "options": { "cwd": "${fileDirname}" },
      "problemMatcher": ["$gcc"],
      "group": "build",
      "detail": "like Codeforces: -O2 -std=c++23 -static -DONLINE_JUDGE"
    }
  ]
}